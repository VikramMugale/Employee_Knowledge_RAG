# Copy to .env and fill the values you have.
# cp .env.example .env

# --- Required ---
GEMINI_API_KEY=
SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET=replace-with-a-long-random-string

# --- Neon Postgres (paste the connection string Neon gives you) ---
# Accepts postgres:// or postgresql:// URLs. sslmode=require is fine.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# --- Qdrant Cloud ---
QDRANT_URL=https://YOUR-CLUSTER.cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION=employee_rag_chunks

# --- Voyage / Atlas Embedding and Reranking API ---
# Paste the Model API key created in Atlas → AI Model APIs.
VOYAGE_API_KEY=
VOYAGE_BASE_URL=https://ai.mongodb.com/v1
RERANK_MODEL=rerank-2.5
RERANK_TOP_K=8

# --- Langfuse ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- OpenSearch (BM25 keyword search) ---
OPENSEARCH_URL=https://YOUR-OPENSEARCH-HOST:443
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX=employee_rag_chunks

# --- Optional / leave blank. Not used by this app. ---
# REDIS_URL=

# --- Safe defaults ---
APP_NAME=Employee Knowledge RAG Platform
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
JWT_ISSUER=employee-rag
JWT_AUDIENCE=employee-rag-api
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Demo logins (in code, not env):
# employee@acme.com / employee123
# admin@acme.com / admin123
